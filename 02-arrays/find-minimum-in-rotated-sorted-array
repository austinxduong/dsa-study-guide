function findMin(nums) {
        let left = 0
        let right = nums.length - 1

        while (left < right) {
            let mid = Math.floor((left + right) / 2)

            if (nums[mid] < nums[nums.length - 1]) {
                right = mid
            } else if (nums[mid] > nums[nums.length - 1]) {
                left = mid + 1
            }
        }
        return nums[left]
    }

