//refactored
function longestConsecutive(nums) {
        let final = new Set()
        let longest = 0
        
        for (let i=0; i < nums.length; i++) {
            final.add(nums[i])
        }
        for (let value of final) {
            if (final.has(value - 1)) {
                continue
            }
            let length = 1 // if there are only one unequie values in the array skip to the next if check below and return 1. no extra looping needed so no predecessor or successor 
            if (final.has(value + 1)) { // 3 + 1 = 4
                // starting point
                
                let increment = value + 1 // = 3 + 1 = 4
                length++ // length now equals 4
                while (final.has(increment + 1)) { // 4 + 1 = 5 ( 5 doesnt exist - dont increment)
                    increment++ // length stays 4
                    length++
                }
            }
            if (length > longest ) {
                longest = length
            }
        }
        return longest
    }

